# Leave unset in local dev to use the Vite proxy (/api → http://127.0.0.1:8000).
#
# On Vercel, set this as an Environment Variable (Production):
#   VITE_API_URL=https://your-api.example.com
# VITE_API_URL=https://your-deployed-api.example.com
