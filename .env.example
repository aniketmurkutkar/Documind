# Copy to .env and fill in keys locally. Never commit .env.

# Local default is bge-m3. On Render (see render.yaml) we use bge-small-en-v1.5 + 384 dims.
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_DIM=1024
# Hosted / low-RAM example:
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# VECTOR_DIM=384
TOP_K=5
HYBRID_ALPHA=0.7
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
PROMPT_CACHE_TTL_SECONDS=900
PROMPT_CACHE_MAX_SIZE=1000

# Chat model id (name is historical; used for OpenAI, Groq, xAI, etc.)
OPENAI_MODEL=gpt-4o-mini

# Key resolution order: LLM_API_KEY → OPENAI_API_KEY → GROQ_API_KEY
LLM_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# OpenAI-compatible chat host + route
LLM_BASE_URL=https://api.openai.com/v1
# chat_completions | responses  (Groq OSS docs often use responses)
LLM_ROUTE=chat_completions

# Groq example:
# GROQ_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_ROUTE=responses
# OPENAI_MODEL=openai/gpt-oss-20b
#
# xAI Grok example:
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_API_KEY=
# OPENAI_MODEL=

# PDF: PyMuPDF text + tables + optional Tesseract
# https://github.com/tesseract-ocr/tesseract
PDF_MAX_SIZE_MB=25.0
PDF_OCR_ENABLED=true
PDF_OCR_MIN_TEXT_CHARS=50
PDF_OCR_IMAGES=true
PDF_OCR_ZOOM=2.0

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
